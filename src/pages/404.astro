---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { sortWork } from '../lib/work';

const work = sortWork(await getCollection('work'));
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="page fallback">
    <p class="label">404</p>
    <h1>There's nothing at this address.</h1>
    <p>It may have moved when this portfolio was rebuilt. Here is everything that exists:</p>
    <ul>
      {work.map((entry) => <li><a href={`/work/${entry.id}/`}>{entry.data.title}</a></li>)}
      <li><a href="/about/">About</a></li>
      <li><a href="/this-site/">This site</a></li>
    </ul>
  </section>
</Base>

<style>
  .fallback {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
    max-width: 44rem;
    margin-inline: 0;
  }

  h1 {
    font-size: var(--text-title);
    letter-spacing: -0.02em;
  }

  ul {
    margin: 0;
    padding-left: 1.2em;
    font-family: var(--font-label);
  }
</style>
