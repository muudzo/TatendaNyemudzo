---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkFeature from '../components/work/WorkFeature.astro';
import WorkRow from '../components/work/WorkRow.astro';
import PrimitivesMatrix from '../components/work/PrimitivesMatrix.astro';
import IndexList from '../components/work/IndexList.astro';
import { byTier, sortWork } from '../lib/work';
import { EXPERIMENTS, ARCHIVE } from '../data/index';
import { SITE } from '../data/site';

const work = await getCollection('work');
const flagships = byTier(work, 'flagship');
const supporting = byTier(work, 'supporting');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  description: SITE.description,
  email: `mailto:${SITE.email}`,
  url: Astro.site?.href,
  sameAs: SITE.links.map((link) => link.href),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'NHL Stenden University of Applied Sciences' },
};
---

<Base jsonLd={jsonLd}>
  <section class="statement page" aria-labelledby="statement-heading">
    <div class="planet-anchor" data-planet aria-hidden="true"></div>
    <div class="statement-main">
      <h1 id="statement-heading" class="statement-text">
        I design systems for the moment things go wrong, <em>and then I build them.</em>
      </h1>
      <p class="statement-sub">
        Payments, public services and farming in Zimbabwe, where networks drop, the power cuts out
        and trust runs thin. The same person does the field research, the interface and the code.
      </p>
      <p class="statement-proof label">
        This site is built the same way. Switch the power off (top right) and it keeps working.
      </p>
    </div>
    <dl class="statement-ledger">
      <div>
        <dt class="label">Now</dt>
        <dd>Communication &amp; Multimedia Design at NHL Stenden, Leeuwarden, with a software-engineering focus</dd>
      </div>
      <div>
        <dt class="label">Recently</dt>
        <dd>Paynow internship: field research, a payments benchmark and a live marketplace</dd>
      </div>
      <div>
        <dt class="label">Building</dt>
        <dd>Vaka: stage-gated building inspection for Zimbabwe’s councils</dd>
      </div>
    </dl>
  </section>

  <section id="work" class="page work-section" aria-labelledby="work-heading">
    <div class="section-head">
      <h2 id="work-heading">Selected work</h2>
      <span class="label">Research · design · build</span>
    </div>
    {flagships.map((entry, index) => <WorkFeature entry={entry} index={index} />)}
  </section>

  <section class="page work-section" aria-labelledby="supporting-heading">
    <div class="section-head">
      <h2 id="supporting-heading">More work</h2>
      <span class="label">Shorter studies</span>
    </div>
    {supporting.map((entry) => <WorkRow entry={entry} />)}
  </section>

  <section class="page work-section matrix-section" aria-labelledby="matrix-heading">
    <div class="section-head">
      <h2 id="matrix-heading">What keeps coming back</h2>
      <span class="label">Across 7 projects and 5 stacks</span>
    </div>
    <p class="matrix-intro">
      Laravel, Supabase, NestJS, FastAPI, Cloudflare Workers. Different tools, the same habits. This
      table is generated from the case studies themselves.
    </p>
    <PrimitivesMatrix entries={sortWork(work)} />
  </section>

  <section class="page work-section" aria-labelledby="index-heading">
    <div class="section-head">
      <h2 id="index-heading">Experiments</h2>
      <span class="label">Small, curious, unfinished</span>
    </div>
    <IndexList items={EXPERIMENTS} label="Experiments" />

    <div class="section-head archive-head">
      <h2>Archive</h2>
      <span class="label">The path here</span>
    </div>
    <IndexList items={ARCHIVE} label="Archive" />
  </section>
</Base>

<style>
  .statement {
    position: relative;
    /* The planet's box may reach past the edge of a phone; it must never make the page scroll. */
    overflow-x: clip;
    display: grid;
    gap: var(--space-8);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  /*
   * The place set aside for the planet (scripts/sky). The box stays empty; the sky behind the page
   * draws a globe to fill it. Phones: rising behind the controls. Tablets: beside the claim.
   * Desktop: above the ledger.
   */
  .planet-anchor {
    position: absolute;
    top: -7.5rem;
    right: -2.75rem;
    width: 10rem;
    aspect-ratio: 1;
    pointer-events: none;
  }

  @media (min-width: 40rem) {
    .planet-anchor {
      top: 3rem;
      right: calc(var(--gutter) + 1.5rem);
      width: 20vw;
    }
  }

  @media (min-width: 64rem) {
    .planet-anchor {
      top: var(--space-4);
      right: calc(var(--gutter) + 5%);
      width: clamp(14rem, 22vw, 20rem);
    }
  }

  .statement-main {
    display: grid;
    gap: var(--space-6);
  }

  .statement-text {
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    font-weight: 380;
    line-height: 1.04;
    letter-spacing: -0.028em;
    max-width: 16ch;
  }

  /* A highlighter stroke in light mode; the signal colour in dark mode (see --marker tokens). */
  .statement-text em {
    color: var(--marker-ink);
    background: linear-gradient(transparent 58%, var(--marker) 58%, var(--marker) 92%, transparent 92%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-inline: 0.04em;
  }

  .statement-sub {
    font-size: var(--text-lead);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .statement-proof {
    padding-left: var(--space-3);
    border-left: 2px solid var(--stamp);
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: var(--text-small);
    max-width: 34rem;
  }

  :root[data-power='off'] .statement-proof {
    display: none;
  }

  /* On phones the ledger repeats the About page; the work matters more on a small first screen. */
  .statement-ledger {
    display: none;
    gap: var(--space-4);
    margin: 0;
    align-content: end;
  }

  @media (min-width: 40rem) {
    .statement-ledger {
      display: grid;
    }
  }

  .statement-ledger div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-content: start;
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--hairline);
  }

  .statement-ledger dt {
    padding-top: 0.3rem;
  }

  .statement-ledger dd {
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--text-small);
    line-height: 1.45;
  }

  .work-section {
    margin-top: var(--space-section);
  }

  #work {
    margin-top: 0;
  }

  .matrix-intro {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
    color: var(--ink-soft);
  }

  .archive-head {
    margin-top: var(--space-12);
  }

  /*
   * The statement's entrance, in two beats: the claim rises, then "and then I build them." lands
   * last. Pure CSS from the first paint, so nothing waits on a script; power-cut or reduced-motion
   * visitors get the final state. .motion-settled stops a replay when the power comes back on.
   */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-power='off']):not(.motion-settled)) .statement-text {
      --rise: 0.3em;
      animation: rise var(--duration-enter) var(--ease-out-expo) backwards;
    }

    :global(:root:not([data-power='off']):not(.motion-settled)) .statement-text em {
      animation: appear 360ms ease-out 400ms backwards;
    }

    :global(:root:not([data-power='off']):not(.motion-settled))
      :is(.statement-sub, .statement-proof, .statement-ledger > div) {
      animation: rise var(--duration-enter) var(--ease-out-expo) calc(var(--step) * var(--stagger)) backwards;
    }

    .statement-sub {
      --step: 2;
    }
    .statement-proof {
      --step: 3;
    }
    .statement-ledger > div:nth-child(1) {
      --step: 3;
    }
    .statement-ledger > div:nth-child(2) {
      --step: 4;
    }
    .statement-ledger > div:nth-child(3) {
      --step: 5;
    }
  }

  @media (min-width: 64rem) {
    .statement {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--space-12);
      align-items: end;
    }

    .statement-ledger div {
      grid-template-columns: 5.5rem 1fr;
    }
  }
</style>
