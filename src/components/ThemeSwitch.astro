---
/**
 * Light (cobalt-led) or dark (lime-led). Follows the system until the visitor chooses.
 */
---

<button class="theme-button" id="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
  <svg class="theme-icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path class="theme-half" d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .theme-button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--duration-fast) ease;
  }

  .theme-button:hover {
    border-color: var(--ink);
  }

  .theme-icon {
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .theme-button[aria-checked='true'] .theme-icon {
    transform: rotate(180deg);
  }

  .theme-button[aria-checked='true'] .theme-half {
    color: var(--stamp);
  }
</style>
