---
/**
 * The power switch. Turning it off simulates load-shedding: web fonts, colour, diagrams and
 * motion drop away and the page reports how little of it was needed to read it.
 */
---

<div class="power">
  <button
    class="power-button"
    id="power-switch"
    type="button"
    role="switch"
    aria-checked="true"
    aria-describedby="power-hint"
  >
    <span class="power-lamp" aria-hidden="true"></span>
    <span class="power-name">Power</span>
    <span class="power-track" aria-hidden="true"><span class="power-lever"></span></span>
  </button>
  <span class="visually-hidden" id="power-hint">
    Simulates a power cut (load-shedding). The page drops web fonts, colour and diagrams and
    shows text versions instead.
  </span>
</div>

<style>
  .power {
    grid-area: power;
    justify-self: end;
  }

  .power-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-3);
    min-height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-label);
    font-size: var(--text-small);
    font-weight: 560;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .power-button:hover {
    border-color: var(--ink);
  }

  .power-button:active .power-lever {
    transform: translateX(0.35rem) scaleX(1.15);
  }

  .power-lamp {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--stamp);
    box-shadow: 0 0 0 3px var(--stamp-wash);
    transition:
      background-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }

  .power-track {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--ink);
    transition: background-color var(--duration-normal) var(--ease-out-expo);
  }

  .power-lever {
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--paper);
    transform: translateX(1rem);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .power-button[aria-checked='false'] .power-lamp {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--ink-faint);
  }

  .power-button[aria-checked='false'] .power-track {
    background: var(--rule-strong);
  }

  .power-button[aria-checked='false'] .power-lever {
    transform: translateX(0);
  }
</style>
