---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '../styles/global.css';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the Open Graph image, relative to the site root. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description = SITE.description, ogImage = '/og/home.png', jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fcfdff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#070b18" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Decide the power state before first paint. With the power off, fonts are never requested,
      so the body-face preload is only added when the power is on.
    -->
    <script is:inline define:vars={{ fontUrl: newsreaderUrl }}>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem('power');
          var saveData = !!(navigator.connection && navigator.connection.saveData);
          if (saved ? saved === 'off' : saveData) root.dataset.power = 'off';
          if (!saved && saveData) root.dataset.powerReason = 'save-data';
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
        } catch (e) {}
        if (root.dataset.power === 'off') return;
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'font';
        link.type = 'font/woff2';
        link.crossOrigin = 'anonymous';
        link.href = fontUrl;
        document.head.appendChild(link);
      })();
    </script>

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Masthead />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/power';
      import '../scripts/theme';
      import '../scripts/offline';
      import '../scripts/motion';
      import '../scripts/morph';
      import '../scripts/sky';
    </script>
  </body>
</html>
